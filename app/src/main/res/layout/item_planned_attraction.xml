<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de um item da ListView do resumo.
    A descrição e as observações aparecem só no modo detalhado:
    o adapter esconde as duas quando o usuário escolhe a visão compacta.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgPlanned"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/attraction_image_description"
            tools:src="@drawable/ic_adventure" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlannedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Trilha na montanha" />

            <TextView
                android:id="@+id/txtPlannedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="09:00 · 4 h · Difícil" />

            <TextView
                android:id="@+id/txtPlannedDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                tools:text="Caminhada guiada até o mirante." />

            <TextView
                android:id="@+id/txtPlannedNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="italic"
                tools:text="Obs.: levar protetor solar" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
