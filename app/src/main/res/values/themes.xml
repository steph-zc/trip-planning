<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema claro do aplicativo. -->
    <style name="Theme.TripPlanning" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Cor principal: barra de título e fundo dos botões -->
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorPrimaryVariant">@color/ui_primary_dark</item>
        <!-- Cor do texto que aparece por cima da cor principal -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Cor de destaque: CheckBox e RadioButton marcados, SeekBar, ProgressBar -->
        <item name="colorSecondary">@color/ui_accent</item>
        <item name="colorSecondaryVariant">@color/ui_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>

    </style>

</resources>
