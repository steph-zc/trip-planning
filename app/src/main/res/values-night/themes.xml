<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Tema escuro. As cores são as mesmas do tema claro, só que
        invertidas: no fundo escuro a cor principal precisa ser clara,
        senão ela desapareceria.
    -->
    <style name="Theme.TripPlanning" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/ui_primary_light</item>
        <item name="colorPrimaryVariant">@color/ui_accent_light</item>
        <!-- Texto escuro, porque agora o fundo dos botões é claro -->
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/ui_primary_light</item>
        <item name="colorSecondaryVariant">@color/ui_accent_light</item>
        <item name="colorOnSecondary">@color/black</item>

    </style>

</resources>
